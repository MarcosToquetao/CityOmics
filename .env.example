# Copie para .env (que está no .gitignore) e preencha só o que for usar (D28).
# Nunca coloque chaves em código, notebooks ou logs.

# Raiz dos dados (padrão: ./data)
# CITYOMICS_DATA=/caminho/para/data

# Abertura do cofre de 2026: mesmo valor de prereg/UNSEAL_KEY (DOI do OSF ou FREEZE-<sha>)
# CITYOMICS_UNSEAL_KEY=FREEZE-xxxxxxx

# Hoje nenhuma API externa é usada (D24: só Laya local/Colab).
# OPENROUTER_API_KEY=

# NASA Earthdata (VIIRS Black Marble); token gratuito em urs.earthdata.nasa.gov > Generate Token
EARTHDATA_TOKEN=
